{
  "name": "action-metrics",
  "version": "0.2.0",
  "description": "Plataforma de evaluación de desempeño y seguimiento de objetivos",
  "author": "ActionMetrics",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently -k \"next dev --turbopack\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder",
    "electron:pack": "next build && electron-builder --dir"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@uidotdev/usehooks": "^2.4.1",
    "date-fns": "^4.4.0",
    "next": "~15.5.28",
    "next-intl": "^4.14.9",
    "react": "~19.0.9",
    "react-dom": "~19.0.9",
    "react-toastify": "^11.1.0",
    "recharts": "^2.15.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "concurrently": "^9.2.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "~15.5.28",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.actionmetrics.app",
    "productName": "ActionMetrics",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "standalone/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512x512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon-512x512.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon-512x512.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon-512x512.png",
      "uninstallerIcon": "public/icon-512x512.png",
      "installerHeaderIcon": "public/icon-512x512.png"
    },
    "npmRebuild": false
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
