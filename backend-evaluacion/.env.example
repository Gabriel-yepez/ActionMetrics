# Base de datos PostgreSQL
# Opción 1: Conexión local (usar estas variables)
DB_NAME=evaluacion
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
passwordDB=tu_password_aqui

# Opción 2: Conexión remota Neon (si se define DATABASE_URL, se ignoran las variables de arriba)
# DATABASE_URL=postgresql://usuario:password@host/database?sslmode=require

# Servidor
PORT=4001
NODE_ENV=development

# JWT
JWT_SECRET=cambia_esto_por_una_clave_secreta_segura_en_produccion
JWT_EXPIRES_IN=8h

# Cifrado de datos sensibles en la base de datos
# Nombre, apellido, email y cédula de los usuarios, comentarios de evaluaciones y
# retroalimentaciones, planes de mejora y objetivos se guardan cifrados (AES-256-GCM).
# Genera la clave con: openssl rand -base64 32
# ¡Guarda una copia segura! Sin esta clave los datos cifrados no se pueden recuperar.
DATA_ENCRYPTION_KEY=
# Para cambiar la clave: pon la nueva arriba, la anterior aquí (separadas por coma si hay
# varias) y ejecuta `node db/cifrar-datos.js`; después ya puedes quitar la anterior.
# DATA_ENCRYPTION_OLD_KEYS=

# CORS (orígenes permitidos separados por coma)
CORS_ORIGINS=http://localhost:3000

# --- IA (planes de mejora) ---
# Varias claves y proveedores compatibles con la API de OpenAI (el formato de DeepSeek).
# En cada reporte se elige una clave al azar; si falla (límite del plan gratuito, saldo
# agotado, clave inválida, caída del servicio) se usa otra al instante y la que falló
# queda en pausa un tiempo. Sin ninguna clave se genera un análisis simulado.
#
# Claves separadas por coma. DEEPSEEK_API_KEY (una sola) sigue funcionando.
DEEPSEEK_API_KEYS=
# DEEPSEEK_MODEL=deepseek-reasoner
#
# Otros proveedores conocidos: basta con las claves y el modelo. Los nombres de modelo
# son ejemplos: verifica los vigentes en la documentación de cada proveedor.
# GROQ_API_KEYS=gsk_xxx,gsk_yyy
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEYS=AIzaxxx
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_API_KEYS=sk-or-xxx
# OPENROUTER_MODEL=deepseek/deepseek-r1:free
# (también: MISTRAL_, CEREBRAS_, TOGETHER_, OPENAI_ + _API_KEYS / _MODEL)
#
# Proveedor propio compatible con OpenAI (cualquier nombre):
# AI_PROVIDERS=miproveedor
# MIPROVEEDOR_BASE_URL=https://api.miproveedor.com/v1
# MIPROVEEDOR_API_KEYS=xxx
# MIPROVEEDOR_MODEL=nombre-del-modelo
#
# random (por defecto: reparte el uso al azar) | round-robin (en orden, una tras otra)
AI_ROTATION=random
# Tiempo máximo por intento y total por reporte (ms)
# AI_TIMEOUT_MS=120000
# AI_TOTAL_TIMEOUT_MS=170000

# base de datos conection strings
DATABASE_URL=postgresql://usuario:password@host/database?sslmode=require
