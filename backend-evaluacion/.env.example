# Base de datos PostgreSQL
# Opción 1: Conexión local (usar estas variables)
DB_NAME=evaluacion
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
passwordDB=tu_password_aqui

# Opción 2: Conexión remota Neon (si se define DATABASE_URL, se ignoran las variables de arriba)
# DATABASE_URL=postgresql://usuario:password@host/database?sslmode=require

# Servidor
PORT=4001
NODE_ENV=development

# JWT
JWT_SECRET=cambia_esto_por_una_clave_secreta_segura_en_produccion
JWT_EXPIRES_IN=8h

# CORS (orígenes permitidos separados por coma)
CORS_ORIGINS=http://localhost:3000

# DeepSeek AI API (para planes de mejora)
DEEPSEEK_API_KEY=tu_api_key_aqui

# base de datos conection strings
DATABASE_URL=postgresql://usuario:password@host/database?sslmode=require
