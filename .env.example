# Variables para docker compose. Copia este archivo a .env y completa los valores.

# --- Base de datos (PostgreSQL del contenedor "db") ---
DB_NAME=evaluacion
DB_USER=postgres
DB_PASSWORD=cambia_esta_contraseña

# --- Autenticación ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
# true solo si sirves la app por HTTPS (la cookie "Secure" no viaja por HTTP plano)
COOKIE_SECURE=false

# --- Proxy inverso ---
# Número de proxies delante del backend (1 con Nginx en el VPS, 0 sin proxy).
# Necesario para que el rate limiting use la IP real de cada usuario.
TRUST_PROXY=0

# --- URLs y puertos ---
# Origen del frontend permitido por CORS (separar varios con coma)
CORS_ORIGINS=http://localhost:3000
# URL del backend tal como la ve el navegador (se incrusta en el build del frontend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4001
FRONTEND_PORT=3000
BACKEND_PORT=4001
# Interfaz donde se publican los puertos. 127.0.0.1 = solo accesibles desde la propia
# máquina (en el VPS el acceso público es a través de Nginx). 0.0.0.0 = toda la red.
BIND_ADDRESS=127.0.0.1

# --- IA (planes de mejora con DeepSeek) ---
DEEPSEEK_API_KEY=
