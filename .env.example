# Variables para docker compose. Copia este archivo a .env y completa los valores.

# --- Base de datos (PostgreSQL del contenedor "db") ---
DB_NAME=evaluacion
DB_USER=postgres
DB_PASSWORD=cambia_esta_contraseña

# --- Autenticación ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
# true solo si sirves la app por HTTPS (la cookie "Secure" no viaja por HTTP plano)
COOKIE_SECURE=false

# --- Proxy inverso ---
# Número de proxies delante del backend (1 con Nginx en el VPS, 0 sin proxy).
# Necesario para que el rate limiting use la IP real de cada usuario.
TRUST_PROXY=0

# --- URLs y puertos ---
# Origen del frontend permitido por CORS (separar varios con coma)
CORS_ORIGINS=http://localhost:3000
# URL del backend tal como la ve el navegador (se incrusta en el build del frontend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4001
FRONTEND_PORT=3000
BACKEND_PORT=4001
# Interfaz donde se publican los puertos. 127.0.0.1 = solo accesibles desde la propia
# máquina (en el VPS el acceso público es a través de Nginx). 0.0.0.0 = toda la red.
BIND_ADDRESS=127.0.0.1

# --- IA (planes de mejora) ---
# Varias claves y proveedores compatibles con la API de OpenAI (el formato de DeepSeek).
# En cada reporte se elige una clave al azar; si falla (límite del plan gratuito, saldo
# agotado, clave inválida, caída del servicio) se usa otra al instante y la que falló
# queda en pausa un tiempo. Sin ninguna clave se genera un análisis simulado.
#
# Claves separadas por coma. DEEPSEEK_API_KEY (una sola) sigue funcionando.
DEEPSEEK_API_KEYS=
# DEEPSEEK_MODEL=deepseek-reasoner
#
# Otros proveedores conocidos: basta con las claves y el modelo. Los nombres de modelo
# son ejemplos: verifica los vigentes en la documentación de cada proveedor.
# GROQ_API_KEYS=gsk_xxx,gsk_yyy
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEYS=AIzaxxx
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_API_KEYS=sk-or-xxx
# OPENROUTER_MODEL=deepseek/deepseek-r1:free
# (también: MISTRAL_, CEREBRAS_, TOGETHER_, OPENAI_ + _API_KEYS / _MODEL)
#
# Proveedor propio compatible con OpenAI (cualquier nombre):
# AI_PROVIDERS=miproveedor
# MIPROVEEDOR_BASE_URL=https://api.miproveedor.com/v1
# MIPROVEEDOR_API_KEYS=xxx
# MIPROVEEDOR_MODEL=nombre-del-modelo
#
# random (por defecto: reparte el uso al azar) | round-robin (en orden, una tras otra)
AI_ROTATION=random
# Tiempo máximo por intento y total por reporte (ms)
# AI_TIMEOUT_MS=120000
# AI_TOTAL_TIMEOUT_MS=170000
